@@ -0,0 +1,14 @@
+const express = require('express');
+const router = express.Router();
+const steamController = require('../controllers/steam.controller');
+const { authenticateToken } = require('../middlewares/auth');
+
+// Pública: la visita el navegador al volver de Steam (identidad vía `state` firmado)
+router.get('/callback', steamController.callback);
+
+// Protegidas
+router.post('/link', authenticateToken, steamController.startLink);
+router.get('/status', authenticateToken, steamController.getStatus);
+router.delete('/unlink', authenticateToken, steamController.unlink);
+
+module.exports = router;
diff --git a/game-backlog-backend/src/services/steam.service.js b/game-backlog-backend/src/services/steam.service.js
new file mode 100644
index 0000000..bf33559
--- /dev/null
+++ b/game-backlog-backend/src/services/steam.service.js
@@ -0,0 +1,131 @@
+const axios = require('axios');
+const jwt = require('jsonwebtoken');
+
+const STEAM_OPENID_URL = 'https://steamcommunity.com/openid/login';
+const OPENID_NS = 'http://specs.openid.net/auth/2.0';
+const IDENTIFIER_SELECT = 'http://specs.openid.net/auth/2.0/identifier_select';
+const CLAIMED_ID_REGEX = /^https?:\/\/steamcommunity\.com\/openid\/id\/(\d{17})$/;
+const STATE_TTL = '10m';
+const NONCE_MAX_AGE_MS = 5 * 60 * 1000;
+
+const getBackendUrl = () =>
+  (process.env.BACKEND_URL || `http://localhost:${process.env.PORT || 3000}`).replace(/\/+$/, '');
+
+const getCallbackBase = () => `${getBackendUrl()}/api/steam/callback`;
+
+// IMPORTANTE: el `state` NO se firma con JWT_SECRET a secas. El middleware de auth
+// acepta cualquier JWT firmado con JWT_SECRET que traiga `userId`, así que un state
+// firmado igual (y filtrado en una URL) serviría como token de sesión.
+const stateSecret = () => `${process.env.JWT_SECRET}:steam-openid-state`;
+
+const signState = (payload) =>
+  jwt.sign({ ...payload, purpose: 'steam_openid' }, stateSecret(), { expiresIn: STATE_TTL });
+
+const verifyState = (token) => {
+  const decoded = jwt.verify(token, stateSecret());
+  if (decoded.purpose !== 'steam_openid') throw new Error('Invalid state purpose');
+  return decoded;
+};
+
+// URL a la que se manda al usuario para autenticarse en Steam.
+const buildAuthUrl = (state) => {
+  const returnTo = `${getCallbackBase()}?state=${encodeURIComponent(state)}`;
+  const params = new URLSearchParams({
+    'openid.ns': OPENID_NS,
+    'openid.mode': 'checkid_setup',
+    'openid.return_to': returnTo,
+    'openid.realm': getBackendUrl(),
+    'openid.identity': IDENTIFIER_SELECT,
+    'openid.claimed_id': IDENTIFIER_SELECT,
+  });
+  return `${STEAM_OPENID_URL}?${params.toString()}`;
+};
+
+// Valida la respuesta de Steam y devuelve el SteamID64.
+// Nunca confía en los parámetros de la URL por sí solos: la prueba real es que
+// Steam responda `is_valid:true` a check_authentication.
+const verifyAssertion = async (query) => {
+  if (query['openid.ns'] !== OPENID_NS) throw new Error('OpenID: namespace inválido');
+  if (query['openid.mode'] !== 'id_res') throw new Error('OpenID: modo inválido');
+  if (query['openid.op_endpoint'] !== STEAM_OPENID_URL) throw new Error('OpenID: op_endpoint inválido');
+
+  // El return_to firmado por Steam debe ser nuestro callback y con el mismo state.
+  let returnTo;
+  try {
+    returnTo = new URL(query['openid.return_to']);
+  } catch {
+    throw new Error('OpenID: return_to inválido');
+  }
+  const expected = new URL(getCallbackBase());
+  if (returnTo.origin !== expected.origin || returnTo.pathname !== expected.pathname) {
+    throw new Error('OpenID: return_to no coincide');
+  }
+  if (!query.state || returnTo.searchParams.get('state') !== query.state) {
+    throw new Error('OpenID: state no coincide');
+  }
+
+  // Los campos que Steam debió firmar deben incluir los críticos.
+  const signed = String(query['openid.signed'] || '').split(',');
+  for (const field of ['op_endpoint', 'claimed_id', 'identity', 'return_to', 'response_nonce', 'assoc_handle']) {
+    if (!signed.includes(field)) throw new Error(`OpenID: el campo ${field} no está firmado`);
+  }
+
+  // Frescura del nonce (evita reutilizar una aserción vieja).
+  const nonceTime = Date.parse(String(query['openid.response_nonce'] || '').slice(0, 20));
+  if (Number.isNaN(nonceTime) || Math.abs(Date.now() - nonceTime) > NONCE_MAX_AGE_MS) {
+    throw new Error('OpenID: nonce expirado');
+  }
+
+  const match = CLAIMED_ID_REGEX.exec(String(query['openid.claimed_id'] || ''));
+  if (!match) throw new Error('OpenID: claimed_id inválido');
+  const steamId = match[1];
+
+  // Verificación directa con Steam.
+  const body = new URLSearchParams();
+  Object.keys(query).forEach((key) => {
+    if (key.startsWith('openid.')) body.append(key, String(query[key]));
+  });
+  body.set('openid.mode', 'check_authentication');
+
+  const response = await axios.post(STEAM_OPENID_URL, body.toString(), {
+    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+    timeout: 10000,
+  });
+
+  if (!/(^|\n)is_valid:true(\n|$)/.test(String(response.data))) {
+    throw new Error('OpenID: Steam rechazó la aserción');
+  }
+
+  return steamId;
+};
+
+// Perfil público (nombre, avatar, URL). Es "best effort": si falla o no hay
+// STEAM_API_KEY, la vinculación igual se completa.
+const getPlayerSummary = async (steamId) => {
+  if (!process.env.STEAM_API_KEY) return null;
+  try {
+    const response = await axios.get('https://api.steampowered.com/ISteamUser/GetPlayerSummaries/v2/', {
+      params: { key: process.env.STEAM_API_KEY, steamids: steamId },
+      timeout: 10000,
+    });
+    const player = response.data?.response?.players?.[0];
+    if (!player) return null;
+    return {
+      persona_name: player.personaname || null,
+      avatar_url: player.avatarfull || player.avatar || null,
+      profile_url: player.profileurl || null,
+    };
+  } catch (err) {
+    console.warn('⚠️ No se pudo obtener el perfil de Steam:', err.message);
+    return null;
+  }
+};
+
+module.exports = {
+  STEAM_OPENID_URL,
+  signState,
+  verifyState,
+  buildAuthUrl,
+  verifyAssertion,
+  getPlayerSummary,
+};
diff --git a/game-backlog-frontend/src/components/settings/SteamConnectionCard.jsx b/game-backlog-frontend/src/components/settings/SteamConnectionCard.jsx
new file mode 100644
index 0000000..c8d7481
--- /dev/null
+++ b/game-backlog-frontend/src/components/settings/SteamConnectionCard.jsx
@@ -0,0 +1,164 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { useSearchParams } from 'react-router-dom';
+import toast from 'react-hot-toast';
+import { ExternalLink } from 'lucide-react';
+import axios from '../../api/axios';
+import { ENDPOINTS } from '../../utils/constants';
+import SteamIcon from '../../assets/steam-icon.svg?react';
+
+// Resultado que el backend deja en /settings?steam=<resultado> al volver de Steam
+const STEAM_RESULTS = {
+  linked: { type: 'success', message: 'Steam account linked successfully!' },
+  cancelled: { type: 'error', message: 'Steam sign-in was cancelled.' },
+  already_linked: { type: 'error', message: 'That Steam account is already linked to another Stackd account.' },
+  already_has_account: { type: 'error', message: 'Your account already has a Steam account linked.' },
+  invalid_state: { type: 'error', message: 'The Steam link request expired. Please try again.' },
+  verification_failed: { type: 'error', message: 'We could not verify your Steam sign-in. Please try again.' },
+  error: { type: 'error', message: 'Something went wrong linking your Steam account.' },
+};
+
+const SteamConnectionCard = () => {
+  const [searchParams, setSearchParams] = useSearchParams();
+  const [status, setStatus] = useState(null); // null = cargando
+  const [busy, setBusy] = useState(false);
+  const [confirmUnlink, setConfirmUnlink] = useState(false);
+  const handledResult = useRef(false);
+
+  const loadStatus = useCallback(async () => {
+    try {
+      const response = await axios.get(ENDPOINTS.STEAM.STATUS);
+      setStatus(response.data);
+    } catch {
+      setStatus({ linked: false, failed: true });
+    }
+  }, []);
+
+  useEffect(() => {
+    loadStatus();
+  }, [loadStatus]);
+
+  // Mostrar el resultado del flujo OpenID una sola vez y limpiar la URL
+  useEffect(() => {
+    const result = searchParams.get('steam');
+    if (!result || handledResult.current) return;
+    handledResult.current = true;
+
+    const info = STEAM_RESULTS[result] || STEAM_RESULTS.error;
+    if (info.type === 'success') toast.success(info.message);
+    else toast.error(info.message);
+
+    const next = new URLSearchParams(searchParams);
+    next.delete('steam');
+    setSearchParams(next, { replace: true });
+  }, [searchParams, setSearchParams]);
+
+  const handleLink = async () => {
+    setBusy(true);
+    try {
+      const response = await axios.post(ENDPOINTS.STEAM.LINK);
+      window.location.href = response.data.url; // sale hacia Steam
+    } catch (error) {
+      toast.error(error.response?.data?.error || 'Could not start Steam linking.');
+      setBusy(false);
+    }
+  };
+
+  const handleUnlink = async () => {
+    setBusy(true);
+    try {
+      await axios.delete(ENDPOINTS.STEAM.UNLINK);
+      toast.success('Steam account unlinked.');
+      setConfirmUnlink(false);
+      await loadStatus();
+    } catch (error) {
+      toast.error(error.response?.data?.error || 'Could not unlink Steam.');
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="bg-primary-navy-dark rounded-lg p-6 mb-6 transition-colors">
+      <div className="flex items-center gap-3 mb-4">
+        <div className="p-3 bg-[#00adee]/20 rounded-lg">
+          <SteamIcon className="w-6 h-6 fill-[#00adee]" />
+        </div>
+        <div>
+          <h3 className="text-lg font-semibold text-white">Steam</h3>
+          <p className="text-sm text-gray-400">Link your Steam account to import your library and stats</p>
+        </div>
+      </div>
+
+      {status === null && <p className="text-gray-400 text-sm">Loading...</p>}
+
+      {status?.failed && (
+        <p className="text-gray-400 text-sm mb-4">Could not load your Steam connection status.</p>
+      )}
+
+      {status && !status.linked && (
+        <button
+          onClick={handleLink}
+          disabled={busy}
+          className="w-full sm:w-auto bg-[#00adee] hover:opacity-90 disabled:opacity-60 text-white px-6 py-2 rounded-lg font-semibold transition-all"
+        >
+          {busy ? 'Redirecting to Steam...' : 'Link Steam Account'}
+        </button>
+      )}
+
+      {status?.linked && (
+        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
+          <div className="flex items-center gap-3 min-w-0">
+            {status.avatar_url ? (
+              <img src={status.avatar_url} alt="" className="w-12 h-12 rounded-lg shrink-0" />
+            ) : (
+              <div className="w-12 h-12 rounded-lg bg-gray-700 shrink-0" />
+            )}
+            <div className="min-w-0">
+              <p className="text-white font-medium truncate">{status.persona_name || 'Steam account'}</p>
+              <p className="text-xs text-gray-400">SteamID: {status.steam_id64}</p>
+              {status.profile_url && (
+                <a
+                  href={status.profile_url}
+                  target="_blank"
+                  rel="noopener noreferrer"
+                  className="inline-flex items-center gap-1 text-xs text-[#00adee] hover:underline"
+                >
+                  View Steam profile <ExternalLink size={12} />
+                </a>
+              )}
+            </div>
+          </div>
+
+          {!confirmUnlink ? (
+            <button
+              onClick={() => setConfirmUnlink(true)}
+              className="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg font-medium transition-colors"
+            >
+              Unlink
+            </button>
+          ) : (
+            <div className="flex items-center gap-2">
+              <span className="text-sm text-gray-300">Unlink Steam?</span>
+              <button
+                onClick={handleUnlink}
+                disabled={busy}
+                className="bg-red-500 hover:bg-red-600 disabled:opacity-60 text-white px-4 py-2 rounded-lg font-medium transition-colors"
+              >
+                {busy ? 'Unlinking...' : 'Confirm'}
+              </button>
+              <button
+                onClick={() => setConfirmUnlink(false)}
+                disabled={busy}
+                className="text-gray-400 hover:text-white px-2 py-2 transition-colors"
+              >
+                Cancel
+              </button>
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+};
+
+export default SteamConnectionCard;
